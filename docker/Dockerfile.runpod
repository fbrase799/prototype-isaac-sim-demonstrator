# Isaac Sim 6.0.1 image for RunPod (Linux/amd64).
# Build this on GitHub Actions, not on a Mac. Pulling NGC requires an NGC API key.
#
#   docker build --platform linux/amd64 -f docker/Dockerfile.runpod -t isaac-sim-demonstrator:latest .
#
# Setting ACCEPT_EULA=Y accepts the NVIDIA Omniverse license:
# https://docs.omniverse.nvidia.com/platform/latest/common/nvidia-omniverse-license-agreement.html

FROM --platform=linux/amd64 nvcr.io/nvidia/isaac-sim:6.0.1

USER root

ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DRIVER_CAPABILITIES=all

# Xorg + noVNC. Do not install xserver-xorg-video-nvidia-* (use host nvidia_drv.so).
# Do not install xvfb — Kit RTX cannot present on it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server \
        rsync \
        vim \
        git \
        curl \
        openssl \
        xorg \
        xserver-xorg-core \
        xinit \
        x11-xserver-utils \
        xauth \
        mesa-utils \
        x11vnc \
        novnc \
        websockify \
        openbox \
        xterm \
        x11-apps \
        x11-utils \
        dbus-x11 \
        procps \
    && mkdir -p /run/sshd /var/run/sshd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Experiment scripts are not baked in. Clone or rsync the repo onto the pod.
COPY docker/entrypoint.runpod.sh /usr/local/bin/entrypoint.runpod.sh
COPY docker/gui.sh /usr/local/bin/isaac-gui.sh

RUN chmod +x /usr/local/bin/entrypoint.runpod.sh /usr/local/bin/isaac-gui.sh

EXPOSE 22 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.runpod.sh"]
